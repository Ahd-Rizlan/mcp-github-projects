{
  "name": "github-projects-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A local MCP server for GitHub Projects V2.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "github-projects-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/clients",
    "docs/ghes.md",
    "docs/security.md",
    "docs/compatibility.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test",
    "test:coverage": "node --experimental-test-coverage --import tsx --test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/keyring": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
